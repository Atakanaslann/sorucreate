# ── Depolama (Supabase) ─────────────────────────────────────────────
# Boş bırakılırsa havuz bu bilgisayarda data/pool.json dosyasında tutulur.
# Değerler: Supabase panel → Project Settings → API
SUPABASE_URL=https://fcosvpownjvqduodrrey.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Soru üretimi ────────────────────────────────────────────────────
# Varsayılan: "Abonelik" modu. Bu bilgisayardaki Claude Code (claude) komutu,
# Claude Pro/Max aboneliğinle çalışır; API anahtarı GEREKMEZ.
# CLAUDE_BIN=claude
# CLAUDE_CODE_MODEL=opus

# Uygulama Vercel gibi bir sunucudaysa üretimi bilgisayarındaki `npm run worker` yapar:
# URETICI=harici

# İsteğe bağlı, ücretli: tanımlanırsa "API" modu da açılır.
# ANTHROPIC_API_KEY=
